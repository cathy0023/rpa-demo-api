# rpa-demo-api 环境变量示例(全部为占位空值,真实密钥只放部署环境/本地 .env,.env 已被 .gitignore 排除)
# 复制: cp .env.example .env  然后仅填入你自己的值,切勿提交 .env

# --- 七小饱 RPA 平台(app/config.py) ---
RPA_PLATFORM_BASE_URL=
# RPA_PLATFORM_APP_KEY / RPA_PLATFORM_APP_SECRET / RPA_PLATFORM_CALLBACK_SECRET /
# RPA_PLATFORM_CALLBACK_AESKEY 为敏感密钥,留空则仅 mock 链路可用(启动时告警缺失项)
RPA_PLATFORM_APP_KEY=
RPA_PLATFORM_APP_SECRET=
RPA_PLATFORM_CALLBACK_SECRET=
RPA_PLATFORM_CALLBACK_AESKEY=

# --- 通用 LLM,OpenAI 兼容接口(app/config.py);未配置 key 时话术生成优雅降级 ---
RPA_DEMO_LLM_BASE_URL=
RPA_DEMO_LLM_API_KEY=
RPA_DEMO_LLM_MODEL=
RPA_DEMO_LLM_TIMEOUT=

# --- SQLite(app/config.py) ---
RPA_DEMO_SQLITE_PATH=

# --- 企微侧边栏基础(app/wecom/config.py):企微后台「我的企业」/自建应用详情获取 ---
WECOM_CORP_ID=
WECOM_AGENT_ID=
# 应用 Secret 属敏感密钥,绝不入库
WECOM_APP_SECRET=

# --- 侧边栏安全(app/wecom/config.py) ---
# JS-SDK 可信域名(与企微后台「网页授权及JS-SDK」配置一致);留空=开发模式放行(仅本地联调用)
WECOM_SID_TRUSTED_DOMAIN=
# 会话 cookie 的 HMAC 签名密钥(敏感,建议 openssl rand -hex 32 生成)
WECOM_SID_COOKIE_SECRET=

# --- 会话存档同步(可选;false=降级,/history 返回空数组) ---
WECOM_SID_ENABLED=false
# 轮询间隔秒数(默认 5)
WECOM_SID_POLL_INTERVAL=
# 官方会话存档 C SDK(libWeWorkFinanceSdk_C.so/.dylib)绝对路径
WECOM_SID_SDK_PATH=
# 会话存档 RSA 私钥 PEM 全文(敏感,与企微后台配置的公钥配对;由 app/wecom/sync.py 读取,绝不入库)
WECOM_SID_MSGAUDIT_PRIVATE_KEY=
